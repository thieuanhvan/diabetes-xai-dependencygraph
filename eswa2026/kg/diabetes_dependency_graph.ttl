@prefix kg: <https://example.org/anonymised-review/kg#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Guideline dependency graph of the diabetes recourse audit, in knowledge-graph form. An edge states that a guideline names acting on the
# subject as a recognised route to changing the object. It encodes no effect size and no causal model.
kg:recognisedRouteTo a rdf:Property ; rdfs:label "recognised route to" .

kg:BMI a kg:SurveyFeature ; rdfs:label "Body mass index" ;
    kg:role kg:lever ; kg:direction "bidirectional" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/NCIT_C16358> ;
    skos:closeMatch <http://www.ebi.ac.uk/efo/EFO_0004340> ;
    skos:closeMatch <https://loinc.org/39156-5> ;
    rdfs:comment "SNOMED CT and UMLS codes not assigned (licence required)." .
kg:PhysActivity a kg:SurveyFeature ; rdfs:label "Physical activity in the past 30 days outside work" ;
    kg:role kg:lever ; kg:direction "monotonic_up" ;
    skos:closeMatch <http://purl.obolibrary.org/obo/NCIT_C17708> ;
    skos:closeMatch <http://www.ebi.ac.uk/efo/EFO_0003940> ;
    rdfs:comment "SNOMED CT and UMLS codes not assigned (licence required)." .
