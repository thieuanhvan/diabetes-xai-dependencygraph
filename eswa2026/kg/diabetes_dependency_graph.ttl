kg:e01 a rdf:Statement ; rdf:subject kg:PhysActivity ; rdf:predicate kg:recognisedRouteTo ; rdf:object kg:BMI ;
    kg:authority kg:ADA2026 ; kg:location "SoC 2026, S5, Rec 5.12" ;
    kg:strength "graded" ; kg:grade "A" ;
    kg:supportScore "0.9"^^xsd:decimal ;
    kg:paraphrase "A weight-management plan built on nutrition, physical activity and behavioural support targets 5-7% weight loss."@en ;
    kg:documentLink <https://doi.org/10.2337/dc26-S005> ;
    kg:extraction "single reader (conference paper)" .
kg:e02 a rdf:Statement ; rdf:subject kg:PhysActivity ; rdf:predicate kg:recognisedRouteTo ; rdf:object kg:BMI ;
    kg:authority kg:ADA2026 ; kg:location "SoC 2026, S8, Rec 8.8a" ;
    kg:strength "graded" ; kg:grade "A" ;
    kg:supportScore "0.9"^^xsd:decimal ;
    kg:paraphrase "Structured counselling centred on nutrition and physical activity to achieve a daily energy deficit."@en ;
    kg:documentLink <https://doi.org/10.2337/dc26-S008> ;
    kg:extraction "single reader (conference paper)" .
