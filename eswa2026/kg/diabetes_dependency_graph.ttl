    kg:strength "graded" ; kg:grade "B" ;
    kg:supportScore "0.7"^^xsd:decimal ;
    kg:paraphrase "Eating patterns should emphasise whole fruits, among other principles."@en ;
    kg:documentLink <https://doi.org/10.2337/dc26-S005> ;
    kg:extraction "single reader (conference paper)" .
